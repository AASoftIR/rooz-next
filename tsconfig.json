{
  "compilerOptions": {
    "target": "ES2022", "module": "ES2022", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "strict": true,
    "outDir": "web", "rootDir": "frontend", "skipLibCheck": true,
    "noEmitOnError": true, "sourceMap": false, "removeComments": false
  },
  "include": ["frontend/**/*.ts"]
}
